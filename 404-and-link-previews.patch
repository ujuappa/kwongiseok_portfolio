diff --git a/src/layouts/Base.astro b/src/layouts/Base.astro
index 22485e7..c1b7c8c 100644
--- a/src/layouts/Base.astro
+++ b/src/layouts/Base.astro
@@ -1,17 +1,32 @@
 ---
 // Shared page shell. The font and accent tokens here are the "shared frame"
 // every interior reuses (docs/PLAN.md → The village).
-import { url } from '../lib/content';
+import { getProfile, url } from '../lib/content';
 
 interface Props {
   title: string;
   description: string;
   /** Path of the canonical copy of this page, if it lives elsewhere. */
   canonicalPath?: string;
+  /** Link-preview image, as a site path. 1200×630 works everywhere. */
+  image?: string;
+  imageAlt?: string;
+  /** Keep the page out of search results (the 404 page). */
+  noindex?: boolean;
 }
 
-const { title, description, canonicalPath } = Astro.props;
+const profile = await getProfile();
+const {
+  title,
+  description,
+  canonicalPath,
+  image = '/og.png',
+  imageAlt = `${profile.name}: portfolio`,
+  noindex = false,
+} = Astro.props;
 const canonical = new URL(canonicalPath ? url(canonicalPath) : Astro.url.pathname, Astro.site);
+// Link previews need an absolute image URL.
+const imageUrl = new URL(url(image), Astro.site);
 ---
 
 <!doctype html>
@@ -21,7 +36,20 @@ const canonical = new URL(canonicalPath ? url(canonicalPath) : Astro.url.pathnam
     <meta name="viewport" content="width=device-width, initial-scale=1" />
     <title>{title}</title>
     <meta name="description" content={description} />
-    <link rel="canonical" href={canonical} />
+    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
+
+    <!-- Link previews (Open Graph, also read by X, Slack, Discord, KakaoTalk, iMessage) -->
+    <meta property="og:type" content="website" />
+    <meta property="og:site_name" content={profile.name} />
+    <meta property="og:title" content={title} />
+    <meta property="og:description" content={description} />
+    {!noindex && <meta property="og:url" content={canonical} />}
+    <meta property="og:image" content={imageUrl} />
+    <meta property="og:image:width" content="1200" />
+    <meta property="og:image:height" content="630" />
+    <meta property="og:image:alt" content={imageAlt} />
+    <meta name="twitter:card" content="summary_large_image" />
+
     <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
     <meta name="generator" content={Astro.generator} />
   </head>
diff --git a/src/pages/404.astro b/src/pages/404.astro
new file mode 100644
index 0000000..1edc959
--- /dev/null
+++ b/src/pages/404.astro
@@ -0,0 +1,51 @@
+---
+// Custom 404. GitHub Pages serves the built 404.html for any unknown path
+// under the site's base.
+import Base from '../layouts/Base.astro';
+import { url } from '../lib/content';
+---
+
+<Base title="Page not found" description="This address isn't on the site." noindex>
+  <main id="main" class="lost">
+    <p class="code" aria-hidden="true">404</p>
+    <h1>Page not found</h1>
+    <p>This address isn't on the map. The link may be out of date or mistyped.</p>
+    <ul>
+      <li><a href={url('/')}>Go to the home page</a></li>
+      <li><a href={url('/map/')}>Open the site index</a></li>
+    </ul>
+  </main>
+</Base>
+
+<style>
+  .lost {
+    max-width: 44rem;
+    margin: 0 auto;
+    padding: 18vh 1rem 4rem;
+  }
+  .code {
+    margin: 0;
+    font-size: clamp(5rem, 22vw, 11rem);
+    font-weight: 800;
+    line-height: 0.9;
+    letter-spacing: -0.04em;
+    color: var(--accent);
+  }
+  h1 {
+    margin: 1.5rem 0 0.5rem;
+    font-size: 1.75rem;
+    line-height: 1.2;
+  }
+  p {
+    margin: 0;
+    color: var(--muted);
+  }
+  ul {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem 1.5rem;
+    list-style: none;
+    padding: 0;
+    margin: 1.5rem 0 0;
+  }
+</style>
