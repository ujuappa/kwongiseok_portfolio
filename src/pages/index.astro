---
// Home. Phase 2 replaces this with the fall (src/scenes/fall/). Until then it
// shows the plain index, with /map/ as the canonical copy for search engines.
import Base from '../layouts/Base.astro';
import PlainIndex from '../components/PlainIndex.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
---

<Base title={profile.name} description={profile.tagline} canonicalPath="/map/">
  <PlainIndex />
</Base>
